# Copy to deploy/.env. Use a bare hostname here, no protocol or path.
DOMAIN=fruzodrinks.com
WWW_DOMAIN=www.fruzodrinks.com
SITE_ORIGIN=https://fruzodrinks.com
RELEASE=local
POSTGRES_DB=fruzo
POSTGRES_USER=fruzo
# Use URL-safe random passwords/tokens. Never commit these values.
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
ENQUIRY_PROXY_TOKEN=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=
ENQUIRY_NOTIFICATION_EMAIL=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
