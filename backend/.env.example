# Local development. Copy to .env; never commit real credentials.
DJANGO_ENV=development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=
FRONTEND_ORIGIN=http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:8017
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
# Generate one random token and use it in BOTH backend and frontend.
ENQUIRY_PROXY_TOKEN=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=
ENQUIRY_NOTIFICATION_EMAIL=
# Production: absolute persistent mount outside backend code.
# MEDIA_ROOT=/var/lib/fruzo/media
TRUST_PROXY_SSL_HEADER=0
TRUST_PROXY_CLIENT_IP=0
HSTS_INCLUDE_SUBDOMAINS=0
HSTS_PRELOAD=0
